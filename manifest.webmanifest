{
  "id": "./",
  "name": "Finanzen",
  "short_name": "Finanzen",
  "description": "Ausgaben und Einnahmen aus Bank-Exporten auswerten. Funktioniert offline.",
  "lang": "de-AT",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3F4F1",
  "theme_color": "#F3F4F1",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{
        "name": "files",
        "accept": ["text/csv", ".csv", "text/comma-separated-values", "application/csv", "text/plain", "application/vnd.ms-excel", "application/octet-stream", "text/*", "application/*", "*/*"]
      }]
    }
  },
  "shortcuts": [
    { "name": "Import", "url": "./#import", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inbox", "url": "./#inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
